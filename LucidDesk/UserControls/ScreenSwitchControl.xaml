<UserControl x:Class="LucidDesk.UserControls.ScreenSwitchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LucidDesk.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="180">
    <Grid>
        <WrapPanel Name="ScreenSelectPanel" >
            <Button Margin="4"  Content="All" Height="40" Width="40" Style="{StaticResource MainButton}"/>
            <Button Margin="4" Content="1" Height="40" Width="40" Style="{StaticResource NormalButton}"/>
        </WrapPanel>  
    </Grid>
</UserControl>
