<UserControl x:Class="LucidDesk.UserControls.Common.PasswordTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LucidDesk.UserControls.Common"
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="300">

    <UserControl.Resources>
        <!-- Removes the default PasswordBox/TextBox chrome so our border/background shows -->
        <Style x:Key="PlainTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BorderBox" TargetType="Border">
            <Setter Property="BorderBrush" Value="Gainsboro"/>
            <Setter Property="BorderThickness" Value="0 0 0 2.4"/>
            <Style.Triggers>
                <!-- Use IsKeyboardFocusWithin on the Border itself so the border changes when any child has keyboard focus -->
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource MainColorBrush}"/>
                    <Setter Property="BorderThickness" Value="0 0 0 2.4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlainPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Eye icon toggle button -->
        <Style x:Key="EyeToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}">
                            <Path x:Name="EyeIcon"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Fill="#777777"
                                  Data="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5ZM12,17C9.24,17 7,14.76 7,12C7,9.24 9.24,7 12,7C14.76,7 17,9.24 17,12C17,14.76 14.76,17 12,17ZM12,9C10.34,9 9,10.34 9,12C9,13.66 10.34,15 12,15C13.66,15 15,13.66 15,12C15,10.34 13.66,9 12,9Z"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- when checked = password visible, show "eye-off" -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="EyeIcon" Property="Data"
                                        Value="M12,7C14.76,7 17,9.24 17,12C17,12.65 16.87,13.26 16.64,13.83L19.57,16.76C21.07,15.49 22.27,13.86 23,12C21.27,7.61 17,4.5 12,4.5C10.73,4.5 9.51,4.72 8.36,5.11L10.17,6.92C10.74,6.69 11.35,6.56 12,6.56ZM2,4.27L4.28,6.55L4.74,7.01C3.08,8.3 1.78,10.02 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.09L19.73,22L21,20.73L3.27,3L2,4.27ZM7.53,9.8L9.08,11.35C9.03,11.56 9,11.78 9,12C9,13.66 10.34,15 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17C9.24,17 7,14.76 7,12C7,11.21 7.2,10.47 7.53,9.8ZM11.84,9.02L14.99,12.17L15.01,12.01C15.01,10.35 13.67,9.01 12.01,9.01L11.84,9.02Z"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Outer container matches the design: light rounded-top card + blue bottom border -->
        <Border  Background="{Binding TextboxBackground}"  CornerRadius="{Binding CornerRadius}" Style="{StaticResource BorderBox}" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Hidden text (PasswordBox) -->
                <PasswordBox x:Name="PART_PasswordBox"
                         Grid.Column="0"
                         Style="{StaticResource PlainPasswordBoxStyle}"
                         FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                         PasswordChanged="PasswordBox_PasswordChanged"
                         Visibility="Visible"/>

                <!-- Visible text (TextBox), shown when eye is toggled on -->
                <TextBox x:Name="PART_VisibleTextBox"
                     Grid.Column="0"
                     Style="{StaticResource PlainTextBoxStyle}"
                     FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                     TextChanged="VisibleTextBox_TextChanged"
                     Visibility="Collapsed"/>

                <!-- Placeholder label (watermark) -->
                <Label x:Name="PlaceholderLabel"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Padding="12,0,0,0"
                       Foreground="{Binding PlaceholderColor}"
                       Background="Transparent"
                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                       Content="{Binding Placeholder}" />

                <ToggleButton x:Name="PART_ToggleButton"
                          Grid.Column="1"
                          Style="{StaticResource EyeToggleButtonStyle}"
                          Checked="ToggleButton_CheckedChanged"
                          Unchecked="ToggleButton_CheckedChanged"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
    