                        </Viewbox>
                        <TextBlock>Setting</TextBlock>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Style="{StaticResource ContextMenuItem}" Click="SettingPageClick" >
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Height="14" Width="14" Margin="10 0" >
                            <Path VerticalAlignment="Stretch"    HorizontalAlignment="Stretch" Stroke="Black" StrokeThickness="2" Data="{StaticResource Profile}"/>
                        </Viewbox>
                        <TextBlock>Profile</TextBlock>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <MenuItem Style="{StaticResource ContextMenuItem}" >
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Height="16" Width="16" Margin="10 0" >
                            <Path VerticalAlignment="Stretch"    HorizontalAlignment="Stretch" Stroke="Black" StrokeThickness="1.5" Data="{StaticResource Help}"/>
                        </Viewbox>
                        <TextBlock>Help</TextBlock>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <Separator/>
            <MenuItem Style="{StaticResource ContextMenuItem}" Click="CloseButtonClick" >
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Height="14" Width="14" Margin="12 0" >
                            <Path VerticalAlignment="Stretch"    HorizontalAlignment="Stretch" Fill="Black" Stroke="Black" StrokeThickness="1.5" Data="M328.96,30.2933333 L298.666667,0 L164.48,134.4 L30.2933333,0 L0,30.2933333 L134.4,164.48 L0,298.666667 L30.2933333,328.96 L164.48,194.56 L298.666667,328.96 L328.96,298.666667 L194.56,164.48 Z"/>
                        </Viewbox>
                        <TextBlock>Exit</TextBlock>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
        </ContextMenu>

    </Window.Resources>
    <Border Background="{StaticResource SubColorBrush}">
        <Grid x:Name="maingrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid  Background="{StaticResource SubColorBrush}" Grid.Row="0" Margin="0 0 0 5" MouseDown="TitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <Grid  Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" >
                        <Border x:Name="serverStausIndicater" Margin="0 2 0 0"  Height="10" CornerRadius="5" Width="10" VerticalAlignment="Center" HorizontalAlignment="Center" Background="Green">

                        </Border>
                    </Grid>
                    <!--<Image Height="25" VerticalAlignment="Center" HorizontalAlignment="Right" Width="25" Source="/LucidDesk;component\Resources\DeskIcon.png" ></Image>-->
                    <TextBlock Name="headerText"  Grid.Column="1" FontSize="16" HorizontalAlignment="Left" Padding="5 0 0 0" FontWeight="DemiBold" Foreground="{StaticResource MainColorBrush}" VerticalAlignment="Center" >Desk</TextBlock>
                </Grid>
                <Grid Grid.Column="1">
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel Grid.Column="0"   Name="HeaderSessionContainer" Margin="0 1 0 0" >
                        <UserControl:SessionHeaderControl MouseDown="HeaderSessionSwitchClick"  x:Name="SessionTabHeader" Height="40"   ></UserControl:SessionHeaderControl>
                        <Button  Name="NewSessionCreateButton" Visibility="Hidden" Click="NewSessionCreateButtonOnClick"  Width="30"  Background="{StaticResource SubColorBrush}" Style="{StaticResource NormalButton}"  >
                            <Button.ToolTip>
                                <ToolTip Content="New Session"></ToolTip>
                            </Button.ToolTip>
                            <Path VerticalAlignment="Stretch"  HorizontalAlignment="Stretch" Stroke="Gray" StrokeThickness="1.5" Data="{StaticResource AddDesktop}"></Path>
                        </Button>

                    </WrapPanel>
                    <DockPanel  DockPanel.Dock="Right" Grid.Column="1">
                        <Button  Name="normalScreenButton" HorizontalAlignment="Center" VerticalAlignment="Center"  Visibility="Hidden"  Click="NormalScreenButtonOnClick"  Width="30" Background="{StaticResource SubColorBrush}" Style="{StaticResource NormalButton}"  >
                            <Button.ToolTip>
                                <ToolTip Content="Normal Screen"></ToolTip>
                            </Button.ToolTip>
                            <Path VerticalAlignment="Stretch"  HorizontalAlignment="Stretch" Stroke="Gray" StrokeThickness="1" Data="{StaticResource Screen}"></Path>
                        </Button>
                        <UserControl:ScreenSwitchControl x:Name="screenSwitchControl" MinWidth="100" Visibility="Hidden" HorizontalAlignment="Right"></UserControl:ScreenSwitchControl>
                    </DockPanel>
                </Grid>

                <Grid Grid.Column="2" HorizontalAlignment="Right" Width="170">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                  
                    <Border Grid.Column="1">
                        <Button Click="RefreshButtonClick" Style="{StaticResource RectangleButton}"  >
                            <Button.ToolTip>
                                <ToolTip Content="Refresh"></ToolTip>
                            </Button.ToolTip>
                            <Path VerticalAlignment="Stretch" Height="20" Width="20"  HorizontalAlignment="Stretch" Stroke="Gray"  StrokeThickness="1.5" Data="{StaticResource Refresh}"></Path>
                        </Button>
                    </Border>
                    <Border Grid.Column="2">
                        <Button Click="MinimizeButtonClick" Style="{StaticResource RectangleButton}"  >
                            <Button.ToolTip>
                                <ToolTip Content="Minimize"></ToolTip>
                            </Button.ToolTip>
                            <Path VerticalAlignment="Stretch" Height="12" Width="12"  HorizontalAlignment="Stretch" Stroke="Gray" StrokeThickness="1.5" Data="{StaticResource Minimize}"></Path>
                        </Button>
                    </Border>
                    <Border Grid.Column="3">
                        <Button Click="MaximizeButtonClick" Style="{StaticResource RectangleButton}">
                            <Button.ToolTip>
                                <ToolTip Content="Maximize"></ToolTip>
                            </Button.ToolTip>

                            <Path VerticalAlignment="Stretch" Height="13" Width="13"  HorizontalAlignment="Stretch" Stroke="Gray" StrokeThickness="1.5" Data="{StaticResource Rectangle}"></Path>
                        </Button>
                    </Border>
                    <Border Grid.Column="4">
                        <Button Click="CloseButtonClick" Style="{StaticResource CloseButton}" >
                            <Button.ToolTip>
                                <ToolTip Content="Close"></ToolTip>
                            </Button.ToolTip>
                            <Path VerticalAlignment="Stretch" Height="12" Width="12"  HorizontalAlignment="Stretch" Stroke="Gray" StrokeThickness="1.5" Data="{StaticResource Cancel}"></Path>
                        </Button>
                    </Border>
                </Grid>
            </Grid>
            <Grid Name="searchBarGrid" Grid.Row="1" Margin="4 0" Height="45" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>

                    <ColumnDefinition  Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Border>
                    <Path x:Name="connectedStausIcon" Visibility="Hidden" VerticalAlignment="Stretch" Height="24" Width="24"  HorizontalAlignment="Stretch" Stroke="Green" StrokeThickness="1.5" Data="{StaticResource Tick}"></Path>
                </Border>
                <Border Margin="0 2" Grid.Column="1">
                    <UserControl:SearchBoxControl x:Name="SearchBoxControl" FontWeight="DemiBold" Background="White" FontSize="16"   Placeholder="Desk Id" FontFamily="Segoe UI" ></UserControl:SearchBoxControl>
                </Border>
                <Button Name="MenuButton" Background="{StaticResource SubColorBrush}"  IsTabStop="False" Foreground="Black" Click="MenuButtonClick" MouseRightButtonDown="MenuButtonMouseRightButtonDown" Grid.Column="2" Height="35" Width="35" VerticalAlignment="Center" HorizontalAlignment="Center"   Style="{StaticResource NormalButton}">
                    <Button.ToolTip>
                        <ToolTip Content="Menu"></ToolTip>
                    </Button.ToolTip>
                    <Path VerticalAlignment="Stretch" Height="20" Width="20"  HorizontalAlignment="Stretch" Stroke="Gray" StrokeThickness="2" Data="m 0 10 L 20 10 M 20 3 L 0 3 M 0 16 L 20 16"></Path>
                </Button>
            </Grid>

            <TabControl Name="MainTabControl" BorderThickness="0" BorderBrush="{StaticResource SubColorBrush}" SelectionChanged="MainTabControlSelectionChanged" Grid.Row="2" Style="{StaticResource Tabcontrol}">

                <TabItem x:Name="HomePage" BorderThickness="0" >
                    <Grid>
                        <Border >
                            <ScrollViewer>
                                <Grid  >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="100"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!--<Border Grid.Row="0" Margin="2" Background="{StaticResource MainColorBrush}">
                                        <TextBlock ></TextBlock>
                                    </Border>-->
                                    <Border Grid.Row="0">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock  VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"  Margin="10 0" FontWeight="SemiBold" Text="Your Address">
                                                    <TextBlock.Style>

                                                        <Style TargetType="TextBlock">

                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground"  Value="{StaticResource MainColorBrush}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock  Name="TextblockId" VerticalAlignment="Center" HorizontalAlignment="Center"  FontSize="22" Margin="15 0" FontWeight="Bold" >

                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource MainColorBrush}"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground"  Value="{Binding RelativeSource={RelativeSource Self},Path=Foreground,Converter={StaticResource ColorReduction},Mode=OneTime}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style></TextBlock>
                                                <Button Name="InviteButton" Click="InviteButtonClick" Height="30" FontWeight="DemiBold" Width="80"  BorderThickness="2" HorizontalContentAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource MainColorBrush}">
                                                    <Button.ToolTip>
                                                        <ToolTip Content="Invite"></ToolTip>
                                                    </Button.ToolTip>
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Padding" Value="5"/>
                                                            <Setter Property="FontSize" Value="15"/>
                                                            <!--<Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>-->
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Foreground" Value="{StaticResource MainColorBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource SubColorBrush}"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="BorderBox" Padding="0"  BorderThickness="{TemplateBinding BorderThickness}"  BorderBrush="{TemplateBinding BorderBrush}"  CornerRadius="3"  Background="{TemplateBinding Background}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"></ContentPresenter>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter  Property="Background"    Value="{StaticResource MainColorBrush}"/>
                                                                    <Setter  Property="Foreground"    Value="white"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseCaptured" Value="True">
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal"   VerticalAlignment="Center" HorizontalAlignment="Center" >
                                                        <Path  Width="30"   VerticalAlignment="Center" HorizontalAlignment="Center" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.5"  Data="M14.734 15.8974L19.22 12.1374C19.3971 11.9927 19.4998 11.7761 19.4998 11.5474C19.4998 11.3187 19.3971 11.1022 19.22 10.9574L14.734 7.19743C14.4947 6.9929 14.1598 6.94275 13.8711 7.06826C13.5824 7.19377 13.3906 7.47295 13.377 7.78743V9.27043C7.079 8.17943 5.5 13.8154 5.5 16.9974C6.961 14.5734 10.747 10.1794 13.377 13.8154V15.3024C13.3888 15.6178 13.5799 15.8987 13.8689 16.0254C14.158 16.1521 14.494 16.1024 14.734 15.8974Z"></Path>
                                                        <TextBlock  Margin="0 0 7 0"  VerticalAlignment="Center" HorizontalAlignment="Center" Text="Invite">

                                                        </TextBlock>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" Padding="15 4">
                                        <UserControl:CustomHeaderSwicthControl x:Name="DeskSwicthControl" Foreground="gray" Margin="20 0" Height="45" ></UserControl:CustomHeaderSwicthControl>
                                    </Border >

                                    <StackPanel Name="DeskMainContainer" Grid.Row="2"  >
                                        <StackPanel Name="RecentSessionsDeskContainer"  Margin="10 20" MinHeight="198">
                                            <Border Height="30" BorderThickness="0 0 0 0" BorderBrush="Gray">
                                                <DockPanel  >
                                                    <TextBlock Padding="15 0" Foreground="Gray" FontSize="14" FontWeight="DemiBold">Recent Sessions</TextBlock>
                                                    <CheckBox Click="RecentSessionsShowMoreClick" FontWeight="DemiBold" Style="{StaticResource ShowMoreCheckBox}" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" >
                                                        <CheckBox.ToolTip>
                                                            <ToolTip Content="RecentSessions desk Show"></ToolTip>
                                                        </CheckBox.ToolTip>
                                                    </CheckBox>
                                                </DockPanel>
                                            </Border>
                                            <WrapPanel Name="RecentSessionsDeskControlContainer"  Margin="5 10" >


                                            </WrapPanel>
                                        </StackPanel>
                                        <StackPanel  Name="FavoritesDeskContainer"  Margin="10 20" MinHeight="198" >
                                            <Border Height="30" BorderThickness="0 0 0 0" BorderBrush="{StaticResource MainColorBrush}">
                                                <DockPanel  >
                                                    <TextBlock Padding="15 0" Foreground="Gray" FontSize="14" FontWeight="DemiBold">Favorites</TextBlock>
                                                    <CheckBox Click="FavoritesShowMoreClick" FontWeight="DemiBold" Style="{StaticResource ShowMoreCheckBox}" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" >
                                                        <CheckBox.ToolTip>
                                                            <ToolTip Content="Favorites desk Show"></ToolTip>
                                                        </CheckBox.ToolTip>
                                                    </CheckBox>
                                                </DockPanel>

                                            </Border>
                                            <WrapPanel Name="FavoritesDeskControlContainer"  Margin="10 5"  >

                                            </WrapPanel>
                                        </StackPanel>
                                        <StackPanel Name="DiscoveredDeskContainer" Margin="10 20" MinHeight="198" >
                                            <Border Height="30" BorderThickness="0 0 0 0" BorderBrush="{StaticResource MainColorBrush}">
                                                <DockPanel  >
                                                    <TextBlock Padding="15 0" Foreground="Gray" FontSize="14" FontWeight="DemiBold">Discovered</TextBlock>
                                                    <CheckBox Click="DiscoveredShowMoreClick"  FontWeight="DemiBold" Style="{StaticResource ShowMoreCheckBox}" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" >
                                                        <CheckBox.ToolTip>
                                                            <ToolTip Content="Discovered desk Show"></ToolTip>
                                                        </CheckBox.ToolTip>
                                                    </CheckBox>
                                                </DockPanel>
                                            </Border>
                                            <WrapPanel Name="DiscoveredDeskControlContainer"  Margin="10 5"  >

                                            </WrapPanel>

                                        </StackPanel>

                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Name="ScreenSharePage">
                    <Grid Name="ScreenShowMainContainer"  >
                        <Image Name="ScreenImage"   ></Image>
                    </Grid>
                </TabItem>
                <TabItem></TabItem>
                <TabItem Name="ConnectionSharePage">
                    <Border Background="White" >
                        <Border Height="160" Width="400" CornerRadius="5" Background="{StaticResource SubColorBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="2"   ShadowDepth="2" Opacity="0.5"  ></DropShadowEffect>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="50"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock Padding="10" Name="TitleTextBlock" FontWeight="DemiBold" FontSize="18">Connection</TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Row="1">
                                    <TextBlock  HorizontalAlignment="Center"  VerticalAlignment="Center"  Padding="10"   FontSize="14">Connection establish please wait</TextBlock>
                                </StackPanel>
                                <DockPanel  Grid.Row="2">
                                    <Button DockPanel.Dock="Right" Click="ConnectionCancelButtonClick"   Content="Cancel" Style="{StaticResource NormalButton}" Background="{StaticResource MainColorBrush}" Margin="0 0 30 0"  Width="125"  Height="35">
                                    </Button>
                                    <Button   BorderThickness="1"  BorderBrush="Gainsboro"    Foreground="Black" Background="White"  Style="{StaticResource NormalButton}" Margin="0 0 30 0"  Width="125" Height="35">
                                        <!--<MediaElement  Name="GifMediaElement" Width="35" Height="30" LoadedBehavior="Manual" UnloadedBehavior="Stop" />-->
                                        <Image  Name="AnimatedGifImage" Height="32" Width="32"></Image>
                                    </Button>
                                </DockPanel>
                            </Grid>
                        </Border>

                    </Border>

                </TabItem>
                <TabItem Name="SettingPage">
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200" MaxWidth="340"/>
                            <ColumnDefinition Width="5*"/>
                        </Grid.ColumnDefinitions>
                        <Border Padding="6 4" BorderBrush="Gainsboro"  >
                            <StackPanel Background="#F4F4F4" >
                                <CheckBox Name="AccountButton" Margin="1" BorderThickness="0" Background="{Binding RelativeSource={RelativeSource TemplatedParent}}" PreviewKeyDown="ButtonPreviewKeyDown"  IsChecked="True"  Click="SettingPageTabButtonClick" Height="35" FontWeight="Normal"  Style="{StaticResource ButtonCheckBoxSettingPage}">
                                    <Grid  Margin="20 0 0 0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0">
                                            <Viewbox Height="15" Width="15" VerticalAlignment="Center" HorizontalAlignment="Center"  >
                                                <Path Name="SectionIconPath" Fill="Black" Stroke="Black" StrokeThickness="1" Data="{StaticResource Profile}"></Path>
                                            </Viewbox>
                                        </Border>
                                        <Border Grid.Column="1"  Padding="10 2" >
                                            <TextBlock Text="Account" VerticalAlignment="Center"></TextBlock>
                                        </Border>
                                    </Grid>
                                </CheckBox>
                                <CheckBox Name="HelpButton" Margin="1" Background="{Binding RelativeSource={RelativeSource TemplatedParent}}" PreviewKeyDown="ButtonPreviewKeyDown" BorderThickness="0" Click="SettingPageTabButtonClick"   Height="35" FontWeight="Normal"  Style="{StaticResource ButtonCheckBoxSettingPage}">
                                    <Grid Margin="20 0 0 0" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" >
                                            <Viewbox Height="15" VerticalAlignment="Center" HorizontalAlignment="Center" Width="15" >
                                                <Path  Stroke="Black" StrokeThickness="1" Data="{StaticResource Help}"></Path>
                                            </Viewbox>
                                        </Border>
                                        <Border Grid.Column="1"  Padding="10 2" >
                                            <TextBlock Text="Help" VerticalAlignment="Center" ></TextBlock>
                                        </Border>
                                    </Grid>
                                </CheckBox>

                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1">
                            <TabControl Name="settingPageTabControl" Style="{StaticResource Tabcontrol}">
                                <TabItem Name="ProfilePage">
                                    <Grid  Background="Gainsboro" >
                                        <Border Padding="5" Margin="20"  Background="White" CornerRadius="7">

                                            <Grid MaxWidth="1400">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5*" MinWidth="440"/>
                                                    <ColumnDefinition Width="3*" MinWidth="180"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0"  >
                                                    <Border Padding="5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" MinWidth="150" MaxWidth="250"/>
                                                                <ColumnDefinition Width="*" MinWidth="350"/>

                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0"  FontSize="16"    FontWeight="Medium" Foreground="{StaticResource MainColorBrush}">Name</Label>
                                                            <StackPanel Orientation="Horizontal" Grid.Column="1">
                                                                <Controls:TextBoxEditControl x:Name="profilePageUserNameTextBox" DoneButtonClicked="UserNameTextBoxEdited"></Controls:TextBoxEditControl>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <Border Padding="5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" MinWidth="150" MaxWidth="250"/>
                                                                <ColumnDefinition Width="*" MinWidth="350"/>

                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0"  FontSize="16"    FontWeight="Medium" Foreground="{StaticResource MainColorBrush}">Password</Label>
                                                            <StackPanel Orientation="Horizontal" Grid.Column="1">
                                                                <Controls:TextBoxEditControl x:Name="profilePagePasswordTextBox"  DoneButtonClicked="PasswordTextBoxEdited"></Controls:TextBoxEditControl>
                                                            </StackPanel>

                                                        </Grid>
                                                    </Border>
                                                    <Border Padding="5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" MinWidth="150" MaxWidth="250"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0"  FontSize="16"    FontWeight="Medium" Foreground="{StaticResource MainColorBrush}">Desk ID</Label>
                                                            <Label x:Name="ProfilePageUserDeskId"  Grid.Column="1" FontSize="16" Foreground="DarkGray"  Margin="30 0" FontWeight="Medium" >1243434425</Label>
                                                        </Grid>
                                                    </Border>
                                                    <Border Padding="5">
                                                        <Grid >
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" MinWidth="150" MaxWidth="250"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0"  FontSize="16"    FontWeight="Medium" Foreground="{StaticResource MainColorBrush}">Desk Name</Label>
                                                            <Label x:Name="ProfilePageUserDeskName" Grid.Column="1" TextBlock.TextAlignment="Left" Foreground="DarkGray" FontSize="16"   Margin="30 0" FontWeight="Medium" >Aer-1</Label>
                                                        </Grid>
                                                    </Border>
                                                    <Border Padding="5">
                                                        <Grid >
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" MinWidth="150" MaxWidth="250"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Label Grid.Column="0"  FontSize="16"    FontWeight="Medium" Foreground="{StaticResource MainColorBrush}">Os</Label>
                                                            <Label x:Name="ProfilePageUserDeskOsName" Grid.Column="1" TextBlock.TextAlignment="Left" Foreground="DarkGray" FontSize="16"   Margin="30 0" FontWeight="Medium" >Windows</Label>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="15"  Background="{StaticResource SubColorBrush}">
                                                    <StackPanel>
                                                        <Grid Height="180" >
                                                            <Controls:RoundedImage x:Name="ProfilePicture"   MinHeight="120" MinWidth="120" MaxHeight="140" MaxWidth="140"   ZoomFactor="1" Stretch="UniformToFill"   CornerRadius="140 " Panel.ZIndex="-1"  Image="/LucidDesk;component/Resources/Screenshot (36).png" Style="{StaticResource RoundedImage}"  ></Controls:RoundedImage>
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal" Margin="7 0" HorizontalAlignment="Center">
                                                            <Label HorizontalAlignment="Center" TextBlock.TextAlignment="Center"  FontSize="17"    FontWeight="Medium" Foreground="{StaticResource MainColorBrush}">Profile</Label>
                                                            <Button x:Name="profileImageEditButton" Click="ProfileImageEditButtonClick" Width="20" Height="20" Margin="4 0" VerticalAlignment="Center" HorizontalAlignment="Center" Background="White" Style="{StaticResource NormalButton}">
                                                                <Button.ToolTip>
                                                                    <ToolTip Content="Edit profile"></ToolTip>
                                                                </Button.ToolTip>
                                                                <Path  Stretch="Fill" VerticalAlignment="Center" Stroke="Black"  Width="15" Height="15" HorizontalAlignment="Center" StrokeThickness="1.4" Data="{StaticResource Edit}"/>
                                                            </Button>
                                                        </StackPanel>

                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </TabItem>
                                <TabItem Name="HelpPage">

                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>

</Window>

    
