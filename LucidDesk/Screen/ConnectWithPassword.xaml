<Window x:Class="LucidDesk.Screen.ConnectWithPassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LucidDesk"
         xmlns:Usercontrol="clr-namespace:LucidDesk.UserControls.Common"
        mc:Ignorable="d"   ResizeMode="NoResize"   WindowStartupLocation="CenterScreen"
        Title="ConnectWithPassword" Height="350" Width="600" WindowStyle="None"  BorderBrush="Gainsboro" BorderThickness="1" Background="{StaticResource SubColorBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel  Background="{StaticResource SubColorBrush}" MouseLeftButtonDown="TopPanelMouseLeftButtonDown" >
            <TextBlock Padding="20 10" FontSize="17" Foreground="{StaticResource MainColorBrush}" FontWeight="SemiBold">Connect</TextBlock>
            <Button HorizontalAlignment="Right" Style="{StaticResource CloseButton}" Height="35" Width="35" Click="CloseButtonClick" >
                <Button.ToolTip>
                    <ToolTip Content="Close"></ToolTip>
                </Button.ToolTip>

                <Path VerticalAlignment="Stretch" Height="12" Width="12"  HorizontalAlignment="Stretch" Stroke="Gray" StrokeThickness="1.5" Data="m 0 0 L 12 12 M 0 12 L 12 0"></Path>
            </Button>
        </DockPanel>
        <StackPanel Grid.Row="1" >
            <StackPanel Margin="2">
                <TextBlock FontSize="14" FontWeight="Medium" Margin="10">User Id</TextBlock>
                <Grid>
                    <Usercontrol:CustomTextBox x:Name="Textbox" FontSize="15" TextChanged="TextboxTextChanged"  FontWeight="Medium" TextboxBackground="White"   Height="40" Width="350"></Usercontrol:CustomTextBox>
                    <Border Name="UserIdLabelContainer" Panel.ZIndex="-1"  Background="White" BorderThickness="1"  CornerRadius="2" Height="40" Width="350" BorderBrush="Gainsboro" >
                        <TextBlock Name="UserIdLabelTextblock"   VerticalAlignment="Center" Padding="12"  FontSize="15"  FontWeight="Medium"    ></TextBlock>
                    </Border>
                </Grid>
            </StackPanel>
            <StackPanel Margin="2">
                <TextBlock FontSize="14" FontWeight="Medium" Margin="10">Password</TextBlock>
                <Grid>
                    <Usercontrol:CustomTextBox x:Name="passwordTextbox" FontSize="15"  TextChanged="TextboxTextChanged"  FontWeight="Medium" TextboxBackground="White"   Height="40" Width="350"></Usercontrol:CustomTextBox>
                    <Border Name="passwordLabelContainer" Panel.ZIndex="-1"  Background="White" BorderThickness="1"  CornerRadius="2" Height="40" Width="350" BorderBrush="Gainsboro" >
                        <TextBlock Name="passwordLabelTextblock"   VerticalAlignment="Center" Padding="12"  FontSize="15"  FontWeight="Medium"    ></TextBlock>
                    </Border>
                </Grid>
            </StackPanel>

            <Border Margin="10">
                <Button Name="ConnectButton" Click="ConnectButtonClick" Height="40" Style="{StaticResource NormalButton }" FontSize="15" Content="Connect" Foreground="White" Background="{StaticResource MainColorBrush}" Width="120"></Button>
            </Border>
        </StackPanel>

    </Grid>
</Window>
